{
    "description": "ACW-PIRxx: Détecteur de mouvement",
    "version": "1.0.0",
    "properties": {
        "temperature0": {
            "type": "float",
            "units": "celsius"
        },
        "humidity0": {
            "type": "float",
            "units": "percent"
        },
        "compteur0": {
            "type": "uint32"
        },
        "compteur_pir": {
            "type": "uint32"
        },
        "temperature_pir": {
            "type": "float",
            "units": "millivolts"
        },
        "type_trame": {
            "type": "string"
        },
        "capteur_dq": {
            "type": "string"
        },
        "boitier": {
            "type": "string"
        },
        "periode": {
            "type": "uint16",
            "units": "minutes"
        },
        "voltagec": {
            "type": "float",
            "units": "volts"
        },
        "voltagev": {
            "type": "float",
            "units": "volts"
        },
        "frame_type": {
            "type": "string"
        },
        "alerte": {
            "type": "string"
        },
        "erreur": {
            "type": "string"
        },
        "horodatage": {
            "type": "string"
        },
        "uplinkFCnt": {
            "name": "uplinkFCnt",
            "type": "uint32"
        },
        "uplinkRSSI": {
            "name": "uplinkRSSI",
            "type": "int16",
            "units": "decibels-millivolt"
        },
        "uplinkSNR": {
            "name": "uplinkSNR",
            "type": "float",
            "units": "decibels"
        },
        "setKeepAlivePeriod": {
            "type": "string",
            "downlink": true
        },
        "setDataloggingPeriod": {
            "type": "uint16",
            "downlink": true
        },
        "setTimestamp": {
            "type": "uint8",
            "downlink": true
        },
        "scheduleDownlinkStatus": {
            "name": "scheduleDownlinkStatus",
            "type": "string"
        }
    },
    "decoder": "acw-pir-bacnet-codec.js",
    "encoder": "acw-pir-bacnet-codec.js"
