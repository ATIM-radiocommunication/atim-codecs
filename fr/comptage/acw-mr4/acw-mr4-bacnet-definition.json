{
    "description": "ACW-MR4: Compteur d’impulsions et contacts secs",
    "version": "1.0.0",
    "properties": {
        "periode": {
            "type": "uint16",
            "units": "minutes"
        },
        "voltagec": {
            "type": "float",
            "units": "volts"
        },
        "voltagev": {
            "type": "float",
            "units": "volts"
        },
        "compteur0": {
            "type": "uint32"
        },
        "compteur1": {
            "type": "uint32"
        },
        "compteur2": {
            "type": "uint32"
        },
        "compteur3": {
            "type": "uint32"
        },
        "input_state0": {
            "type": "uint8"
        },
        "input_state1": {
            "type": "uint8"
        },
        "input_state2": {
            "type": "uint8"
        },
        "input_state3": {
            "type": "uint8"
        },
        "frame_type": {
            "type": "string"
        },
        "alerte": {
            "type": "string"
        },
        "erreur": {
            "type": "string"
        },
        "horodatage": {
            "type": "string"
        },
        "uplinkFCnt": {
            "name": "uplinkFCnt",
            "type": "uint32"
        },
        "uplinkRSSI": {
            "name": "uplinkRSSI",
