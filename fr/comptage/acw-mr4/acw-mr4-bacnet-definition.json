        "setTimestamp": {
            "type": "uint8",
            "downlink": true
        },
        "scheduleDownlinkStatus": {
            "name": "scheduleDownlinkStatus",
            "type": "string"
        }
    },
    "decoder": "acw-mr4-bacnet-codec.js",
    "encoder": "acw-mr4-bacnet-codec.js"
